import java.io.IOException; 
import java.io.PrintWriter; 
import java.util.HashSet; 
import java.util.Set; 
import javax.servlet.ServletException; 
import javax.servlet.annotation.WebServlet; 
import javax.servlet.http.Cookie; 
import javax.servlet.http.HttpServlet; 
import javax.servlet.http.HttpServletRequest; 
import javax.servlet.http.HttpServletResponse; 
import javax.servlet.http.HttpSession; 
@WebServlet("/login") 
public class Servlet extends HttpServlet { 
 private static final long serialVersionUID = 1L; 
 private static Set<String> visitors = new HashSet<String>(); 
 protected void doPost(HttpServletRequest request, 
 HttpServletResponse response) 
 throws ServletException, IOException { 
 response.setContentType("text/html"); 
 PrintWriter out = response.getWriter(); 
 String name = request.getParameter("name"); 
 String gmail = request.getParameter("gmail"); 
 String password = request.getParameter("password"); 
 String mobile = request.getParameter("mobile"); 
 HttpSession session = request.getSession(); 
 session.setAttribute("name", name); 
 session.setAttribute("gmail", gmail); 
 session.setAttribute("mobile", mobile); 
 String sessionId = session.getId(); 
 visitors.add(sessionId); 
 Cookie cookie = new Cookie("user", name); 
 cookie.setMaxAge(60 * 60); 
 response.addCookie(cookie); 
 out.println("<html>"); 
 out.println("<head>"); 
 out.println("<title>Session Tracking Result</title>"); 
 out.println("</head>"); 
 out.println("<body>"); 
 out.println("<h2>Registration Successful</h2>"); 
 out.println("<hr>"); 
 out.println("<h3>User Details</h3>"); 
 out.println("<p><b>Name:</b> " + name + "</p>"); 
 out.println("<p><b>Gmail ID:</b> " + gmail + "</p>"); 
 out.println("<p><b>Mobile Number:</b> " + mobile + "</p>"); 
 out.println("<p><b>Password:</b> ********</p>"); 
 out.println("<hr>"); 
 out.println("<h3>HTTP Session Tracking</h3>"); 
 out.println("<p><b>Session ID:</b> " 
 + sessionId + "</p>"); 
 out.println("<p>Session created successfully.</p>"); 
 out.println("<h3>Cookie Tracking</h3>"); 
 out.println("<p>Cookie created successfully.</p>"); 
 out.println("<p>Cookie Value: " + name + "</p>"); 
 out.println("<h3>Unique Visitor Count</h3>"); 
 out.println("<p><b>Number of Unique Visitors: " 
 + visitors.size() + "</b></p>"); 
 out.println("<hr>"); 
 out.println("<h3>Hidden Form Field Tracking</h3>"); 
 out.println("<form action='login' method='post'>"); 
 out.println("<input type='hidden' " 
 + "name='name' value='" + name + "'>"); 
 out.println("<input type='hidden' " 
 + "name='gmail' value='" + gmail + "'>"); 
 out.println("<input type='hidden' " 
 + "name='mobile' value='" + mobile + "'>"); 
 out.println("<input type='hidden' " 
 + "name='password' value='" + password + "'>"); 
 out.println("<input type='submit' " 
 + "value='Continue using Hidden Form Field'>"); 
 out.println("</form>"); 
 out.println("<hr>"); 
 out.println("<h3>URL Rewriting</h3>"); 
 String url = "login?name=" + name 
 + "&gmail=" + gmail 
 + "&mobile=" + mobile; 
 out.println("<a href='" + url + "'>"); 
 out.println("Continue using URL Rewriting"); 
 out.println("</a>"); 
 out.println("<br><br>"); 
 out.println("<a href='index.html'>Back to Home</a>"); 
 out.println("</body>"); 
 out.println("</html>"); 
 } 
 protected void doGet(HttpServletRequest request, 
 HttpServletResponse response) 
 throws ServletException, IOException { 
 response.setContentType("text/html"); 
 PrintWriter out = response.getWriter(); 
 String name = request.getParameter("name"); 
 String gmail = request.getParameter("gmail"); 
 String mobile = request.getParameter("mobile"); 
 if (name == null) { 
 name = "Guest"; 
 } 
 if (gmail == null) { 
 gmail = "Not Available"; 
 } 
 if (mobile == null) { 
 mobile = "Not Available"; 
 } 
 HttpSession session = request.getSession(); 
 String sessionId = session.getId(); 
 visitors.add(sessionId); 
 out.println("<html>"); 
 out.println("<head>"); 
 out.println("<title>URL Rewriting</title>"); 
 out.println("</head>"); 
 out.println("<body>"); 
 out.println("<h2>URL Rewriting Session Tracking</h2>"); 
 out.println("<hr>"); 
 out.println("<h3>Welcome, " + name + "</h3>"); 
 out.println("<p><b>Gmail ID:</b> " 
 + gmail + "</p>"); 
 out.println("<p><b>Mobile Number:</b> " 
 + mobile + "</p>"); 
 out.println("<p><b>Session ID:</b> " 
 + sessionId + "</p>"); 
 out.println("<p><b>Unique Visitors:</b> " 
 + visitors.size() + "</p>"); 
 out.println("<p>User information was transferred " 
 + "through URL rewriting.</p>"); 
 out.println("<br>"); 
 out.println("<a href='index.html'>Back to Home</a>"); 
 out.println("</body>"); 
 out.println("</html>"); 
 } 
}
