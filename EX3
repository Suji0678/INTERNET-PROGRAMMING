    <!-- JAVASCRIPT -->
    <script>
        const prices = {
            "Laptop": 45000,
            "Mobile": 20000,
            "Smart Watch": 3000
        };

        let cart = [];

        function addToCart(event) {
            event.preventDefault();

            const product = document.getElementById("product").value;
            const quantity = Number(
                document.getElementById("quantity").value
            );
            const size = document.getElementById("size").value;
            const address = document.getElementById("address").value.trim();

            if (!product || quantity < 1 || !address) {
                alert("Please enter all required details.");
                return;
            }

            cart.push({
                product: product,
                quantity: quantity,
                size: size,
                address: address,
                total: prices[product] * quantity
            });

            displayCart();

            alert("Product added to cart successfully!");
        }

        function displayCart() {
            const cartDetails = document.getElementById("cartDetails");

            cartDetails.innerHTML = "";

            if (cart.length === 0) {
                cartDetails.textContent = "Your cart is empty.";
                return;
            }

            const table = document.createElement("table");

            table.innerHTML = `
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Size</th>
                    <th>Total Price</th>
                    <th>Action</th>
                </tr>
            `;

            let grandTotal = 0;

            cart.forEach(function(item, index) {
                grandTotal += item.total;

                const row = table.insertRow();

                const values = [
                    item.product,
                    item.quantity,
                    item.size,
                    "₹" + item.total.toLocaleString("en-IN")
                ];

                values.forEach(function(value) {
                    const cell = row.insertCell();
                    cell.textContent = value;
                });

                const actionCell = row.insertCell();
                const removeButton = document.createElement("button");

                removeButton.textContent = "Remove";
                removeButton.type = "button";

                removeButton.onclick = function() {
                    cart.splice(index, 1);
                    displayCart();
                };

                actionCell.appendChild(removeButton);
            });

            cartDetails.appendChild(table);

            const totalHeading = document.createElement("h3");
            totalHeading.textContent =
                "Grand Total: ₹" + grandTotal.toLocaleString("en-IN");

            cartDetails.appendChild(totalHeading);
        }
    </script>

